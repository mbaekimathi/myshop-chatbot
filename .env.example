# Copy to `.env` after cloning, then fill in your own MySQL details.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real DB passwords or secret keys.

APP_ENV=local

# Leave MySQL off for SQLite / tests; turn on for a real MY-SHOP DB.
MYSQL_ENABLED=False
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30
MYSQL_CONNECT_TIMEOUT=5
MYSQL_CONN_MAX_AGE=60
# MYSQL_UNIX_SOCKET=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# PUBLIC_SITE_URL=https://your-domain.example

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
